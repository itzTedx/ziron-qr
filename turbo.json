{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_BASE_URL", "NEXT_PUBLIC_CLIENT_URL", "PRODUCTION_URL"],
  "globalPassThroughEnv": [
    "CI",
    "npm_lifecycle_event",
    "NEXT_RUNTIME",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "DB_HOST",
    "DB_PORT",
    "DB_PASSWORD",
    "DB_USER",
    "DB_NAME",
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "AWS_BUCKET_NAME",
    "AWS_BUCKET_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "UNSPLASH_ACCESS_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false,
      "interactive": true
    },
    "generate": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui:add": {
      "cache": false,
      "interactive": true
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:fix": {
      "dependsOn": ["^format:fix"]
    }
  }
}
